<Window x:Class="FcuControl.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WINCTRL 32 FCU 控制器" Height="720" Width="1040"
        MinHeight="600" MinWidth="900" WindowStartupLocation="CenterScreen"
        Background="#F5F7FA" Icon="Assets/FcuControl-icon.png">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#172033" Padding="22,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="WINCTRL 32 FCU 控制器" Foreground="White" FontSize="24" FontWeight="SemiBold" />
                    <TextBlock x:Name="StatusText" Text="正在启动" Foreground="#C8D1E6" FontSize="13" Margin="0,6,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="PauseButton" Content="暂停" Click="PauseButton_Click" />
                    <Button Content="刷新设备" Click="RefreshButton_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <TabControl Grid.Row="1" Margin="14" Background="White">
            <TabItem Header="状态">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20">
                        <UniformGrid Columns="3" Margin="0,0,0,18">
                            <Border Background="#EEF3FF" CornerRadius="8" Padding="16" Margin="5">
                                <StackPanel>
                                    <TextBlock Text="FCU 设备" FontWeight="SemiBold" />
                                    <TextBlock x:Name="DeviceStatusText" Margin="0,8,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Border Background="#EEF9F2" CornerRadius="8" Padding="16" Margin="5">
                                <StackPanel>
                                    <TextBlock Text="默认音频输出" FontWeight="SemiBold" />
                                    <TextBlock x:Name="AudioStatusText" Margin="0,8,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Border Background="#FFF6E9" CornerRadius="8" Padding="16" Margin="5">
                                <StackPanel>
                                    <TextBlock Text="飞行软件让位" FontWeight="SemiBold" />
                                    <TextBlock x:Name="ConflictStatusText" Margin="0,8,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <GroupBox Header="调节步长" Padding="14" Margin="5">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="音量" VerticalAlignment="Center" />
                                <TextBox x:Name="VolumeStepBox" Width="55" Margin="8,3,4,3" />
                                <TextBlock Text="%" VerticalAlignment="Center" Margin="0,0,28,0" />
                                <TextBlock Text="亮度" VerticalAlignment="Center" />
                                <TextBox x:Name="BrightnessStepBox" Width="55" Margin="8,3,4,3" />
                                <TextBlock Text="%" VerticalAlignment="Center" Margin="0,0,18,0" />
                                <Button Content="保存步长" Click="SaveStepsButton_Click" />
                                <TextBlock Text="每次有效触发；1% = 1 个百分点" Foreground="#596273"
                                           VerticalAlignment="Center" Margin="18,0,0,0" />
                            </StackPanel>
                        </GroupBox>

                        <TextBlock Text="程序只在手动启动后运行。关闭主窗口会隐藏到系统托盘；必须通过托盘右键“退出”才能结束程序。"
                                   Foreground="#596273" Margin="8,18" TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="输入映射">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="150" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="点击“学习”，然后操作 FCU 上想绑定的按钮、旋钮方向或推拉动作。每个动作保留一个绑定。"
                               TextWrapping="Wrap" Margin="4,4,4,10" />
                    <DataGrid x:Name="MappingGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" HeadersVisibility="Column" Margin="4">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="动作" Binding="{Binding ActionName}" Width="180" />
                            <DataGridTextColumn Header="已绑定 FCU 控件" Binding="{Binding ControlId}" Width="*" />
                            <DataGridTemplateColumn Header="操作" Width="180">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="学习" Click="LearnButton_Click" />
                                            <Button Content="清除" Click="ClearBindingButton_Click" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <GroupBox Grid.Row="2" Header="实时 HID 诊断（最近 100 条）" Margin="4,10,4,4">
                        <ListBox x:Name="DiagnosticList" FontFamily="Consolas" FontSize="11" />
                    </GroupBox>
                </Grid>
            </TabItem>

            <TabItem Header="音频切换">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="为任意 FCU 按键绑定一个 Windows 音频输出设备和状态 LED。按键通过“学习”录入；默认设备被手动更改时，LED 也会自动同步。"
                               TextWrapping="Wrap" Margin="4,4,4,10" />
                    <DockPanel Grid.Row="1" Margin="4,0,4,10">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                            <Button Content="添加切换绑定" Click="AddAudioSwitchButton_Click" />
                            <Button Content="刷新音频设备" Click="RefreshAudioDevicesButton_Click" />
                        </StackPanel>
                        <TextBlock x:Name="CurrentAudioDeviceText" VerticalAlignment="Center" FontWeight="SemiBold" />
                    </DockPanel>
                    <DataGrid x:Name="AudioSwitchGrid" Grid.Row="2" AutoGenerateColumns="False" CanUserAddRows="False"
                              HeadersVisibility="Column" Margin="4">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="已绑定 FCU 控件" Binding="{Binding ControlId}" IsReadOnly="True" Width="220" />
                            <DataGridTemplateColumn Header="目标音频输出设备" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding DeviceOptions}" DisplayMemberPath="Name" SelectedValuePath="Id"
                                                  SelectedValue="{Binding SelectedDeviceId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  SelectionChanged="AudioSwitchDevice_SelectionChanged" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="联动指示灯" Width="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding LedOptions}" DisplayMemberPath="Name"
                                                  SelectedItem="{Binding SelectedLedOption, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  SelectionChanged="AudioSwitchLed_SelectionChanged" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="操作" Width="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="学习" Click="LearnAudioSwitchButton_Click" />
                                            <Button Content="删除" Click="DeleteAudioSwitchButton_Click" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Grid.Row="3" Text="提示：被这里选中的 LED 会优先显示音频设备状态，并覆盖“FCU 输出”页中该 LED 的普通绑定。"
                               Foreground="#596273" Margin="6,10,6,4" TextWrapping="Wrap" />
                </Grid>
            </TabItem>

            <TabItem Header="启动软件">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="把任意 FCU 按键绑定到一个本机应用程序或快捷方式。点击按键后，Windows 会按正常用户权限启动所选软件。"
                               TextWrapping="Wrap" Margin="4,4,4,10" />
                    <Button Grid.Row="1" Content="添加启动绑定" HorizontalAlignment="Left" Margin="4,0,4,10"
                            Click="AddApplicationLaunchButton_Click" />
                    <DataGrid x:Name="ApplicationLaunchGrid" Grid.Row="2" AutoGenerateColumns="False" CanUserAddRows="False"
                              IsReadOnly="True" HeadersVisibility="Column" Margin="4">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="已绑定 FCU 控件" Binding="{Binding ControlId}" Width="220" />
                            <DataGridTemplateColumn Header="目标软件" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="3">
                                            <TextBlock Text="{Binding ApplicationName}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding ExecutablePath}" Foreground="#596273" FontSize="11"
                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding ExecutablePath}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="操作" Width="220">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="选择软件" Click="BrowseApplicationButton_Click" />
                                            <Button Content="学习" Click="LearnApplicationLaunchButton_Click" />
                                            <Button Content="删除" Click="DeleteApplicationLaunchButton_Click" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Grid.Row="3" Text="支持 .exe 和 .lnk。软件移动或卸载后，按键操作会显示失败提示，不会使控制器程序崩溃。"
                               Foreground="#596273" Margin="6,10,6,4" TextWrapping="Wrap" />
                </Grid>
            </TabItem>

            <TabItem Header="显示器">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="勾选需要同步响应 FCU 亮度动作的显示器。多屏会在各自当前值上相对增减。" Margin="4,4,4,10" />
                    <DataGrid x:Name="MonitorGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" Margin="4">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="启用" Width="70">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding Enabled}" HorizontalAlignment="Center"
                                                  IsEnabled="{Binding Controllable}" Click="MonitorEnabled_Click" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="显示器" Binding="{Binding Name}" Width="220" />
                            <DataGridTextColumn Header="接口" Binding="{Binding Backend}" Width="100" />
                            <DataGridTextColumn Header="当前亮度" Binding="{Binding Brightness}" Width="100" />
                            <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="让位程序">
                <Grid Margin="18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="每行一个可执行文件名，可带或不带 .exe。检测到任意一项后会清空 FCU 输出并释放设备。"
                               TextWrapping="Wrap" Margin="3,3,3,10" />
                    <TextBox x:Name="ConflictProcessesBox" Grid.Row="1" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                             FontFamily="Consolas" FontSize="13" />
                    <Button Grid.Row="2" Content="保存进程列表" HorizontalAlignment="Left" Margin="3,10,3,3"
                            Click="SaveConflictProcessesButton_Click" />
                </Grid>
            </TabItem>

            <TabItem Header="FCU 输出">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="数码窗可绑定音量或某一块显示器亮度；LED 可绑定运行状态。改动会立即写入 FCU。"
                               TextWrapping="Wrap" Margin="4,4,4,10" />
                    <DataGrid x:Name="OutputGrid" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False"
                              HeadersVisibility="Column" Margin="4">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="FCU 输出" Binding="{Binding TargetName}" IsReadOnly="True" Width="180" />
                            <DataGridTemplateColumn Header="数据来源" Width="220">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding SourceOptions}" DisplayMemberPath="Label" SelectedValuePath="Kind"
                                                  SelectedValue="{Binding SelectedSource, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  SelectionChanged="OutputSource_SelectionChanged" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="指定显示器" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding MonitorOptions}" DisplayMemberPath="Name" SelectedValuePath="Id"
                                                  SelectedValue="{Binding SelectedMonitorId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  IsEnabled="{Binding NeedsMonitor}"
                                                  SelectionChanged="OutputMonitor_SelectionChanged" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <GroupBox Grid.Row="2" Header="FCU 硬件亮度" Padding="10" Margin="4,10,4,4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="按键背光" VerticalAlignment="Center" />
                            <TextBox x:Name="BacklightBox" Width="55" Margin="7,3,3,3" />
                            <TextBlock Text="LCD" VerticalAlignment="Center" Margin="20,0,0,0" />
                            <TextBox x:Name="LcdBrightnessBox" Width="55" Margin="7,3,3,3" />
                            <TextBlock Text="LED" VerticalAlignment="Center" Margin="20,0,0,0" />
                            <TextBox x:Name="LedBrightnessBox" Width="55" Margin="7,3,3,3" />
                            <TextBlock Text="旋钮步长" VerticalAlignment="Center" Margin="20,0,0,0" />
                            <TextBox x:Name="HardwareBrightnessStepBox" Width="55" Margin="7,3,3,3" />
                            <Button Content="应用硬件亮度" Margin="20,3,3,3" Click="SaveHardwareBrightnessButton_Click" />
                        </StackPanel>
                    </GroupBox>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
