<Window x:Class="FcuControl.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource App.Title}" Height="720" Width="1040"
        MinHeight="600" MinWidth="900" WindowStartupLocation="CenterScreen"
        Background="#F5F7FA" Icon="Assets/FcuControl-icon.png">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#172033" Padding="22,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{DynamicResource App.Title}" Foreground="White" FontSize="24" FontWeight="SemiBold" />
                    <TextBlock x:Name="StatusText" Text="{DynamicResource Status.Starting}" Foreground="#C8D1E6" FontSize="13" Margin="0,6,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource Language.Label}" Foreground="White" VerticalAlignment="Center" Margin="0,0,5,0" />
                    <ComboBox x:Name="LanguageBox" Width="105" Margin="0,3,10,3" SelectedValuePath="Code"
                              DisplayMemberPath="Name" SelectionChanged="LanguageBox_SelectionChanged" />
                    <Button x:Name="PauseButton" Content="{DynamicResource Button.Pause}" Click="PauseButton_Click" />
                    <Button Content="{DynamicResource Button.RefreshDevices}" Click="RefreshButton_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <TabControl Grid.Row="1" Margin="14" Background="White">
            <TabItem Header="{DynamicResource Tab.Status}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20">
                        <UniformGrid Columns="3" Margin="0,0,0,18">
                            <Border Background="#EEF3FF" CornerRadius="8" Padding="16" Margin="5">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Status.Device}" FontWeight="SemiBold" />
                                    <TextBlock x:Name="DeviceStatusText" Margin="0,8,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Border Background="#EEF9F2" CornerRadius="8" Padding="16" Margin="5">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Status.DefaultAudio}" FontWeight="SemiBold" />
                                    <TextBlock x:Name="AudioStatusText" Margin="0,8,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Border Background="#FFF6E9" CornerRadius="8" Padding="16" Margin="5">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Status.FlightSoftwareYield}" FontWeight="SemiBold" />
                                    <TextBlock x:Name="ConflictStatusText" Margin="0,8,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <GroupBox Header="{DynamicResource Group.AdjustmentSteps}" Padding="14" Margin="5">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{DynamicResource Label.Volume}" VerticalAlignment="Center" />
                                <TextBox x:Name="VolumeStepBox" Width="55" Margin="8,3,4,3" />
                                <TextBlock Text="%" VerticalAlignment="Center" Margin="0,0,28,0" />
                                <TextBlock Text="{DynamicResource Label.Brightness}" VerticalAlignment="Center" />
                                <TextBox x:Name="BrightnessStepBox" Width="55" Margin="8,3,4,3" />
                                <TextBlock Text="%" VerticalAlignment="Center" Margin="0,0,18,0" />
                                <Button Content="{DynamicResource Button.SaveSteps}" Click="SaveStepsButton_Click" />
                                <TextBlock Text="{DynamicResource Hint.Step}" Foreground="#596273"
                                           VerticalAlignment="Center" Margin="18,0,0,0" />
                            </StackPanel>
                        </GroupBox>

                        <TextBlock Text="{DynamicResource Hint.Tray}"
                                   Foreground="#596273" Margin="8,18" TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{DynamicResource Tab.InputMappings}">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="150" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="{DynamicResource Hint.InputMappings}"
                               TextWrapping="Wrap" Margin="4,4,4,10" />
                    <DataGrid x:Name="MappingGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" HeadersVisibility="Column" Margin="4">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{DynamicResource Column.Action}" Binding="{Binding ActionName}" Width="180" />
                            <DataGridTextColumn Header="{DynamicResource Column.BoundControl}" Binding="{Binding ControlId}" Width="*" />
                            <DataGridTemplateColumn Header="{DynamicResource Column.Actions}" Width="180">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="{DynamicResource Button.Learn}" Click="LearnButton_Click" />
                                            <Button Content="{DynamicResource Button.Clear}" Click="ClearBindingButton_Click" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <GroupBox Grid.Row="2" Header="{DynamicResource Group.Diagnostics}" Margin="4,10,4,4">
                        <ListBox x:Name="DiagnosticList" FontFamily="Consolas" FontSize="11" />
                    </GroupBox>
                </Grid>
            </TabItem>

            <TabItem Header="{DynamicResource Tab.AudioSwitch}">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="{DynamicResource Hint.AudioSwitch}"
                               TextWrapping="Wrap" Margin="4,4,4,10" />
                    <DockPanel Grid.Row="1" Margin="4,0,4,10">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                            <Button Content="{DynamicResource Button.AddAudioSwitch}" Click="AddAudioSwitchButton_Click" />
                            <Button Content="{DynamicResource Button.RefreshAudioDevices}" Click="RefreshAudioDevicesButton_Click" />
                        </StackPanel>
                        <TextBlock x:Name="CurrentAudioDeviceText" VerticalAlignment="Center" FontWeight="SemiBold" />
                    </DockPanel>
                    <DataGrid x:Name="AudioSwitchGrid" Grid.Row="2" AutoGenerateColumns="False" CanUserAddRows="False"
                              HeadersVisibility="Column" Margin="4">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{DynamicResource Column.BoundControl}" Binding="{Binding ControlId}" IsReadOnly="True" Width="220" />
                            <DataGridTemplateColumn Header="{DynamicResource Column.TargetAudioDevice}" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding DeviceOptions}" DisplayMemberPath="Name" SelectedValuePath="Id"
                                                  SelectedValue="{Binding SelectedDeviceId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  SelectionChanged="AudioSwitchDevice_SelectionChanged" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="{DynamicResource Column.LinkedLed}" Width="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding LedOptions}" DisplayMemberPath="Name"
                                                  SelectedItem="{Binding SelectedLedOption, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  SelectionChanged="AudioSwitchLed_SelectionChanged" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="{DynamicResource Column.Actions}" Width="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="{DynamicResource Button.Learn}" Click="LearnAudioSwitchButton_Click" />
                                            <Button Content="{DynamicResource Button.Delete}" Click="DeleteAudioSwitchButton_Click" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Grid.Row="3" Text="{DynamicResource Hint.AudioLedPriority}"
                               Foreground="#596273" Margin="6,10,6,4" TextWrapping="Wrap" />
                </Grid>
            </TabItem>

            <TabItem Header="{DynamicResource Tab.ApplicationLaunch}">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="{DynamicResource Hint.ApplicationLaunch}"
                               TextWrapping="Wrap" Margin="4,4,4,10" />
                    <Button Grid.Row="1" Content="{DynamicResource Button.AddApplicationLaunch}" HorizontalAlignment="Left" Margin="4,0,4,10"
                            Click="AddApplicationLaunchButton_Click" />
                    <DataGrid x:Name="ApplicationLaunchGrid" Grid.Row="2" AutoGenerateColumns="False" CanUserAddRows="False"
                              IsReadOnly="True" HeadersVisibility="Column" Margin="4">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{DynamicResource Column.BoundControl}" Binding="{Binding ControlId}" Width="220" />
                            <DataGridTemplateColumn Header="{DynamicResource Column.TargetApplication}" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="3">
                                            <TextBlock Text="{Binding ApplicationName}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding ExecutablePath}" Foreground="#596273" FontSize="11"
                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding ExecutablePath}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="{DynamicResource Column.Actions}" Width="220">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="{DynamicResource Button.ChooseApplication}" Click="BrowseApplicationButton_Click" />
                                            <Button Content="{DynamicResource Button.Learn}" Click="LearnApplicationLaunchButton_Click" />
                                            <Button Content="{DynamicResource Button.Delete}" Click="DeleteApplicationLaunchButton_Click" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Grid.Row="3" Text="{DynamicResource Hint.ApplicationTypes}"
                               Foreground="#596273" Margin="6,10,6,4" TextWrapping="Wrap" />
                </Grid>
            </TabItem>

            <TabItem Header="{DynamicResource Tab.Monitors}">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="{DynamicResource Hint.Monitors}" Margin="4,4,4,10" />
                    <DataGrid x:Name="MonitorGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" Margin="4">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="{DynamicResource Column.Enabled}" Width="70">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding Enabled}" HorizontalAlignment="Center"
                                                  IsEnabled="{Binding Controllable}" Click="MonitorEnabled_Click" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="{DynamicResource Column.Monitor}" Binding="{Binding Name}" Width="220" />
                            <DataGridTextColumn Header="{DynamicResource Column.Interface}" Binding="{Binding Backend}" Width="100" />
                            <DataGridTextColumn Header="{DynamicResource Column.CurrentBrightness}" Binding="{Binding Brightness}" Width="100" />
                            <DataGridTextColumn Header="{DynamicResource Column.Status}" Binding="{Binding Status}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="{DynamicResource Tab.Conflicts}">
                <Grid Margin="18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="{DynamicResource Hint.Conflicts}"
                               TextWrapping="Wrap" Margin="3,3,3,10" />
                    <TextBox x:Name="ConflictProcessesBox" Grid.Row="1" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                             FontFamily="Consolas" FontSize="13" />
                    <Button Grid.Row="2" Content="{DynamicResource Button.SaveConflicts}" HorizontalAlignment="Left" Margin="3,10,3,3"
                            Click="SaveConflictProcessesButton_Click" />
                </Grid>
            </TabItem>

            <TabItem Header="{DynamicResource Tab.Output}">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="{DynamicResource Hint.Output}"
                               TextWrapping="Wrap" Margin="4,4,4,10" />
                    <DataGrid x:Name="OutputGrid" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False"
                              HeadersVisibility="Column" Margin="4">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{DynamicResource Column.FcuOutput}" Binding="{Binding TargetName}" IsReadOnly="True" Width="180" />
                            <DataGridTemplateColumn Header="{DynamicResource Column.DataSource}" Width="220">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding SourceOptions}" DisplayMemberPath="Label" SelectedValuePath="Kind"
                                                  SelectedValue="{Binding SelectedSource, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  SelectionChanged="OutputSource_SelectionChanged" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="{DynamicResource Column.SpecifiedMonitor}" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding MonitorOptions}" DisplayMemberPath="Name" SelectedValuePath="Id"
                                                  SelectedValue="{Binding SelectedMonitorId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  IsEnabled="{Binding NeedsMonitor}"
                                                  SelectionChanged="OutputMonitor_SelectionChanged" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <GroupBox Grid.Row="2" Header="{DynamicResource Group.HardwareBrightness}" Padding="10" Margin="4,10,4,4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{DynamicResource Label.Backlight}" VerticalAlignment="Center" />
                            <TextBox x:Name="BacklightBox" Width="55" Margin="7,3,3,3" />
                            <TextBlock Text="LCD" VerticalAlignment="Center" Margin="20,0,0,0" />
                            <TextBox x:Name="LcdBrightnessBox" Width="55" Margin="7,3,3,3" />
                            <TextBlock Text="LED" VerticalAlignment="Center" Margin="20,0,0,0" />
                            <TextBox x:Name="LedBrightnessBox" Width="55" Margin="7,3,3,3" />
                            <TextBlock Text="{DynamicResource Label.KnobStep}" VerticalAlignment="Center" Margin="20,0,0,0" />
                            <TextBox x:Name="HardwareBrightnessStepBox" Width="55" Margin="7,3,3,3" />
                            <Button Content="{DynamicResource Button.ApplyHardwareBrightness}" Margin="20,3,3,3" Click="SaveHardwareBrightnessButton_Click" />
                        </StackPanel>
                    </GroupBox>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
