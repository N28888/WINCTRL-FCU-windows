<Window x:Class="FcuControl.App.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="430" SizeToContent="Height" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False" Topmost="True" ShowActivated="False"
        IsHitTestVisible="False" Opacity="0">
    <Border Background="#E6172033" CornerRadius="14" Padding="22,16">
        <StackPanel>
            <TextBlock x:Name="OverlayTitle" Foreground="White" FontSize="18" FontWeight="SemiBold" />
            <TextBlock x:Name="OverlayDetail" Foreground="#E4E9F3" FontSize="14" Margin="0,6,0,0" TextWrapping="Wrap" />
            <ProgressBar x:Name="OverlayProgress" Minimum="0" Maximum="100" Height="6" Margin="0,12,0,0"
                         Foreground="#6EA0FF" Background="#44506A" Visibility="Collapsed" />
        </StackPanel>
    </Border>
</Window>

